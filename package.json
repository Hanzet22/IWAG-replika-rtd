{
  "name": "iwag-v2",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Independent, static-first IWAG V2 reconstruction with a Rust Active Compiler.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "cargo run --quiet --manifest-path compiler/iwagc/Cargo.toml -- dev",
    "build": "cargo run --quiet --release --manifest-path compiler/iwagc/Cargo.toml -- build",
    "build:astro": "astro build",
    "preview": "cargo run --quiet --manifest-path compiler/iwagc/Cargo.toml -- preview",
    "compiler:inspect": "cargo run --quiet --manifest-path compiler/iwagc/Cargo.toml -- inspect",
    "compiler:doctor": "cargo run --quiet --manifest-path compiler/iwagc/Cargo.toml -- doctor",
    "wasm:build": "cargo run --quiet --manifest-path compiler/iwagc/Cargo.toml -- wasm"
  },
  "dependencies": {
    "astro": "^7.4.13",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@astrojs/vue": "^7.1.6",
    "@tailwindcss/vite": "^4.3.5",
    "tailwindcss": "^4.3.5"
  }
}
