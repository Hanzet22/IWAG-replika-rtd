---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { isLocale } from "../../../i18n/locales";

export async function getStaticPaths() {
  const events = await getCollection("events", ({ data }) => data.status === "published");
  return events.map((event) => {
    const [lang, ...slugParts] = event.id.split("/");
    return { params: { lang, slug: slugParts.join("/") }, props: { event } };
  });
}

const langParam = Astro.params.lang;
const lang = isLocale(langParam) ? langParam : "en";
const { event } = Astro.props;
const { Content } = await render(event);
const labels = {
  en: { eyebrow: "Event information", details: "Event details", date: "Date", end: "End", venue: "Venue", format: "Format", online: "Online", inPerson: "In person", access: "Accessibility information", registration: "Registration information" },
  id: { eyebrow: "Informasi acara", details: "Detail acara", date: "Tanggal", end: "Selesai", venue: "Lokasi", format: "Format", online: "Daring", inPerson: "Tatap muka", access: "Informasi aksesibilitas", registration: "Informasi pendaftaran" },
  "en-sg": { eyebrow: "Event information", details: "Event details", date: "Date", end: "End", venue: "Venue", format: "Format", online: "Online", inPerson: "In person", access: "Accessibility information", registration: "Registration information" },
  "ms-my": { eyebrow: "Maklumat acara", details: "Butiran acara", date: "Tarikh", end: "Tamat", venue: "Lokasi", format: "Format", online: "Dalam talian", inPerson: "Bersemuka", access: "Maklumat kebolehcapaian", registration: "Maklumat pendaftaran" }
}[lang];
const dateLabel = event.data.start
  ? event.data.start.toLocaleDateString(lang, { dateStyle: "long", timeZone: event.data.timezone })
  : null;
---
<BaseLayout lang={lang} title={event.data.title} description={event.data.summary}>
  <article class="page-content">
    <p class="eyebrow">IWAG V2 · {labels.eyebrow}</p>
    <h1>{event.data.title}</h1>
    <p class="lead">{event.data.summary}</p>
    <section class="content-card" aria-labelledby="event-details">
      <h2 id="event-details">{labels.details}</h2>
      {dateLabel && <p><strong>{labels.date}:</strong> {dateLabel}</p>}
      {event.data.end && <p><strong>{labels.end}:</strong> {event.data.end.toLocaleDateString(lang, { dateStyle: "long", timeZone: event.data.timezone })}</p>}
      {event.data.venue && <p><strong>{labels.venue}:</strong> {event.data.venue}</p>}
      <p><strong>{labels.format}:</strong> {event.data.online ? labels.online : labels.inPerson}</p>
      {event.data.accessInformation.length > 0 && <><h3>{labels.access}</h3><ul>{event.data.accessInformation.map((item) => <li>{item}</li>)}</ul></>}
      {event.data.registrationUrl && <p><a class="action-link" href={event.data.registrationUrl}>{labels.registration}</a></p>}
    </section>
    <div class="measure"><Content /></div>
  </article>
</BaseLayout>
