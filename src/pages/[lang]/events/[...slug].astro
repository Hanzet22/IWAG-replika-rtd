---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { isLocale } from "../../../i18n/locales";

export async function getStaticPaths() {
  const events = await getCollection("events", ({ data }) => data.status === "published");
  return events.map((event) => {
    const [lang, ...slugParts] = event.id.split("/");
    return { params: { lang, slug: slugParts.join("/") }, props: { event } };
  });
}

const langParam = Astro.params.lang;
const lang = isLocale(langParam) ? langParam : "en";
const { event } = Astro.props;
const { Content } = await render(event);
const labels = {
  en: { eyebrow: "Event information", details: "Event details", date: "Date", end: "End", venue: "Venue", format: "Format", online: "Online", inPerson: "In person", access: "Accessibility information", registration: "Registration information", body: "About this event", back: "All events" },
  id: { eyebrow: "Informasi acara", details: "Detail acara", date: "Tanggal", end: "Selesai", venue: "Lokasi", format: "Format", online: "Daring", inPerson: "Tatap muka", access: "Informasi aksesibilitas", registration: "Informasi pendaftaran", body: "Tentang acara ini", back: "Semua acara" },
  "en-sg": { eyebrow: "Event information", details: "Event details", date: "Date", end: "End", venue: "Venue", format: "Format", online: "Online", inPerson: "In person", access: "Accessibility information", registration: "Registration information", body: "About this event", back: "All events" },
  "ms-my": { eyebrow: "Maklumat acara", details: "Butiran acara", date: "Tarikh", end: "Tamat", venue: "Lokasi", format: "Format", online: "Dalam talian", inPerson: "Bersemuka", access: "Maklumat kebolehcapaian", registration: "Maklumat pendaftaran", body: "Tentang acara ini", back: "Semua acara" }
}[lang];
const dateLabel = event.data.start
  ? event.data.start.toLocaleDateString(lang, { dateStyle: "long", timeZone: event.data.timezone })
  : null;
---
<BaseLayout lang={lang} title={event.data.title} description={event.data.summary}>
  <article class="page-content event-detail">
    <header class="page-intro">
      <p class="eyebrow">IWAG V2 · {labels.eyebrow}</p>
      <h1>{event.data.title}</h1>
      <p class="lead">{event.data.summary}</p>
    </header>
    <section class="content-card event-details-card" aria-labelledby="event-details">
      <h2 id="event-details">{labels.details}</h2>
      <dl class="event-meta event-detail-meta">
        {dateLabel && <div><dt>{labels.date}</dt><dd><time datetime={event.data.start?.toISOString()}>{dateLabel}</time></dd></div>}
        {event.data.end && <div><dt>{labels.end}</dt><dd><time datetime={event.data.end.toISOString()}>{event.data.end.toLocaleDateString(lang, { dateStyle: "long", timeZone: event.data.timezone })}</time></dd></div>}
        {event.data.venue && <div><dt>{labels.venue}</dt><dd>{event.data.venue}</dd></div>}
        <div><dt>{labels.format}</dt><dd>{event.data.online ? labels.online : labels.inPerson}</dd></div>
      </dl>
      {event.data.accessInformation.length > 0 && <section class="event-access" aria-labelledby="event-access-title"><h3 id="event-access-title">{labels.access}</h3><ul>{event.data.accessInformation.map((item) => <li>{item}</li>)}</ul></section>}
      {event.data.registrationUrl && <p><a class="action-link" href={event.data.registrationUrl} rel="external">{labels.registration}</a></p>}
    </section>
    <section class="measure event-body" aria-labelledby="event-body-title">
      <h2 id="event-body-title">{labels.body}</h2>
      <Content />
    </section>
    <p><a class="text-link" href={`/${lang}/events/`}>{labels.back}</a></p>
  </article>
</BaseLayout>
