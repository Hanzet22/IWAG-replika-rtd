---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GraphicsCapabilityLab from "../../components/GraphicsCapabilityLab.vue";
import ContrastChecker from "../../components/ContrastChecker.vue";
import { legalPolicies, legalPolicySlugs, legalPolicyLinks } from "../../data/legal";
import { getMessages } from "../../i18n/ui";
import { isLocale, localeKeys } from "../../i18n/locales";

const pageTitles: Record<string, Record<string, string>> = {
  en: {
    about: "About this project", community: "Community", "plan-your-visit": "Plan your visit", accessibility: "Accessibility", brand: "Brand resources", ruleset: "Website Ruleset",
    coc: "Code of Conduct", "code-of-conduct": "Code of Conduct", dealers: "Dealers",
    events: "Events", "join-iwag-team": "Join the team", links: "Links", cookies: "Cookie Policy", copyright: "Copyright & Intellectual Property", disclaimer: "Disclaimer", moderation: "Moderation & Reporting", retention: "Data Retention",
    location: "Location", participate: "Participate", policy: "Policies",
    privacy: "Privacy", terms: "Terms", tnc: "Terms and Conditions", updates: "Updates"
  },
  id: {
    about: "Tentang proyek ini", community: "Komunitas", "plan-your-visit": "Rencanakan kunjungan", accessibility: "Aksesibilitas", brand: "Sumber daya merek", ruleset: "Aturan Penggunaan Situs",
    coc: "Kode Etik", "code-of-conduct": "Kode Etik", dealers: "Dealer",
    events: "Acara", "join-iwag-team": "Bergabung dengan tim", links: "Tautan", cookies: "Kebijakan Cookie", copyright: "Hak Cipta & Kekayaan Intelektual", disclaimer: "Penyangkalan", moderation: "Moderasi & Pelaporan", retention: "Retensi Data",
    location: "Lokasi", participate: "Partisipasi", policy: "Kebijakan",
    privacy: "Privasi", terms: "Ketentuan", tnc: "Syarat dan Ketentuan", updates: "Pembaruan"
  },
  "en-sg": {
    about: "About this project", community: "Community", "plan-your-visit": "Plan your visit", accessibility: "Accessibility", brand: "Brand resources",
    coc: "Code of Conduct", "code-of-conduct": "Code of Conduct", dealers: "Dealers",
    events: "Events", "join-iwag-team": "Join the team", links: "Links",
    location: "Location", participate: "Participate", policy: "Policies",
    privacy: "Privacy", terms: "Terms", tnc: "Terms and Conditions", updates: "Updates"
  },
  "ms-my": {
    about: "Perihal projek ini", community: "Komuniti", "plan-your-visit": "Rancang lawatan", accessibility: "Kebolehcapaian", brand: "Sumber jenama",
    coc: "Kod Tatakelakuan", "code-of-conduct": "Kod Tatakelakuan", dealers: "Peniaga",
    events: "Acara", "join-iwag-team": "Sertai pasukan", links: "Pautan",
    location: "Lokasi", participate: "Penyertaan", policy: "Dasar",
    privacy: "Privasi", terms: "Terma", tnc: "Terma dan Syarat", updates: "Kemas kini"
  }
};

export function getStaticPaths() {
  const pageKeys = [
    "about", "community", "plan-your-visit", "accessibility", "brand", "coc", "code-of-conduct", "dealers",
    "join-iwag-team", "links", "location", "participate", "policy", "cookies", "copyright", "disclaimer", "moderation", "retention",
    "privacy", "terms", "tnc", "ruleset", "updates"
  ] as const;
  return localeKeys.flatMap((lang) => pageKeys.map((page) => ({ params: { lang, page } })));
}

const langParam = Astro.params.lang;
const page = Astro.params.page ?? "about";
const lang = isLocale(langParam) ? langParam : "en";
const t = getMessages(lang);
const contentMessages = lang === "ms-my" ? getMessages("en") : t;
const englishFallback = lang === "ms-my" || (lang === "id" && ["location", "participate", "updates"].includes(page));
const title = englishFallback ? pageTitles.en[page] ?? "Information" : pageTitles[lang]?.[page] ?? pageTitles.en[page] ?? "Information";
const legalPages = ["terms", "tnc", "privacy", "coc", "code-of-conduct", "policy", ...legalPolicySlugs];
const policySlug = page === "tnc" ? "terms" : page === "code-of-conduct" ? "coc" : page;
const policy = legalPolicies[policySlug]?.[lang === "id" ? "id" : "en"];
const isLegal = legalPages.includes(page);
const isTerms = page === "terms" || page === "tnc";
const isPrivacy = page === "privacy";
const isAccessibility = page === "accessibility";
const isAbout = page === "about";
const isPlan = page === "plan-your-visit";
const isCommunity = page === "community";
const isLocation = page === "location";
const isParticipate = page === "participate";
const isUpdates = page === "updates";
const isConduct = page === "coc" || page === "code-of-conduct";
const isBrand = page === "brand";
const isDealers = page === "dealers";
const isEvents = page === "events";
const isJoinTeam = page === "join-iwag-team";
const isLinks = page === "links";
const isPolicy = page === "policy";
const copy = policy?.summary ?? (isConduct
  ? (lang === "id" ? "Kode Etik V2 merupakan draf independen." : "The V2 Code of Conduct is an independent draft.")
  : isLegal ? contentMessages.legalDraft
  : isAccessibility ? contentMessages.levelText
  : isPlan ? (lang === "id" ? "Satu titik awal untuk merencanakan kunjungan." : "One starting point for planning a visit.")
  : isCommunity ? (lang === "id" ? "Temukan latar komunitas dan cara terlibat." : "Explore community context and ways to take part.")
  : isAbout ? (lang === "id"
      ? "IWAG V2 adalah rekayasa ulang independen dari arsip referensi. Proyek ini berfokus pada informasi yang mudah dibaca, navigasi konsisten, aksesibilitas, dan minimisasi data."
      : "IWAG V2 is an independent re-engineering project based on a separately archived reference. It focuses on readable information, predictable navigation, accessibility, and data minimisation.")
  : contentMessages.notPublished);
---
<BaseLayout lang={lang} contentLang={englishFallback ? "en" : lang === "id" ? "id" : "en"} title={title} description={copy}>
  <article class="page-content">
    {isLegal && <p class="policy-version">{lang === "id" ? "Rekonstruksi aturan V1 · V2.0 · 25 November 2026" : "V1 rule reconstruction · V2.0 · 25 November 2026"}</p>}
    <header class="page-intro">
      <p class="eyebrow">IWAG V2 · Independent project</p>
      <h1>{title}</h1>
      <p class="lead">{copy}</p>
    </header>
    {isPlan && <section class="landing-grid" aria-label={lang === "id" ? "Rencana kunjungan" : "Visit planning"}>
      <article class="content-card"><p class="eyebrow">01 · EVENT</p><h2>{lang === "id" ? "Tanggal dan acara" : "Dates and event"}</h2><p>3–4 July 2027 · Fantastic Arcana.</p><a href={"/" + lang + "/events/"}>{lang === "id" ? "Lihat informasi acara" : "Explore event information"}</a></article>
      <article class="content-card"><p class="eyebrow">02 · VENUE</p><h2>{lang === "id" ? "Lokasi acara" : "Venue"}</h2><p>Hotel Ciputra Jakarta, West Jakarta.</p><a href={"/" + lang + "/location/"}>{lang === "id" ? "Baca panduan lokasi" : "Read venue information"}</a></article>
      <article class="content-card"><p class="eyebrow">03 · TRAVEL</p><h2>{lang === "id" ? "Perjalanan" : "Getting there"}</h2><p>{lang === "id" ? "Informasi transportasi dan panduan pengunjung internasional." : "Transport information and guidance for international visitors."}</p><a href={"/" + lang + "/international-travelers-guide/"}>{lang === "id" ? "Buka panduan perjalanan" : "Open travel guide"}</a></article>
      <article class="content-card"><p class="eyebrow">04 · PARTICIPATION</p><h2>{lang === "id" ? "Partisipasi" : "Participation"}</h2><p>{lang === "id" ? "Ringkasan tingkat partisipasi yang diumumkan dan status ketersediaannya." : "A snapshot of announced participation tiers and their published availability status."}</p><a href={"/" + lang + "/participate/"}>{lang === "id" ? "Lihat partisipasi" : "View participation"}</a></article>
    </section>}
    {isCommunity && <section class="landing-grid" aria-label={lang === "id" ? "Jelajahi komunitas" : "Explore the community"}>
      <article class="content-card"><p class="eyebrow">01 · CONTEXT</p><h2>{lang === "id" ? "Tentang proyek" : "About the project"}</h2><p>{lang === "id" ? "Konteks dan sejarah pertemuan yang dirangkum secara independen." : "Independent context and a concise history of the gathering."}</p><a href={"/" + lang + "/about/"}>{lang === "id" ? "Baca tentang proyek" : "Read about the project"}</a></article>
      <article class="content-card"><p class="eyebrow">02 · PEOPLE</p><h2>{lang === "id" ? "Tim dan kontribusi" : "Team and contributions"}</h2><p>{lang === "id" ? "Bidang kontribusi yang pernah diumumkan; bukan konfirmasi lowongan aktif." : "Previously announced contribution areas; not confirmation of active vacancies."}</p><a href={"/" + lang + "/join-iwag-team/"}>{lang === "id" ? "Jelajahi peran" : "Explore roles"}</a></article>
      <article class="content-card"><p class="eyebrow">03 · RESOURCES</p><h2>{lang === "id" ? "Sumber daya" : "Resources"}</h2><p>{lang === "id" ? "Tautan, dealer, dan materi merek yang tersedia dalam arsip referensi." : "Links, dealer information, and brand resources available in the reference archive."}</p><a href={"/" + lang + "/links/"}>{lang === "id" ? "Buka sumber daya" : "Browse resources"}</a></article>
      <article class="content-card"><p class="eyebrow">04 · UPDATES</p><h2>{lang === "id" ? "Pembaruan komunitas" : "Community updates"}</h2><p>{lang === "id" ? "Pengumuman dan arsip pembaruan berdasarkan tanggal." : "Dated announcements and the historical update archive."}</p><a href={"/" + lang + "/updates/"}>{lang === "id" ? "Lihat pembaruan" : "Read updates"}</a></article>
    </section>}
    {isEvents && <section class="content-card">
      <p class="eyebrow">IWAG 2027 · FANTASTIC ARCANA</p>
      <h2>3–4 July 2027</h2>
      <h3>Hotel Ciputra Jakarta</h3>
      <p>{lang === "id" ? "Pengumuman publik yang diperiksa pada 23 November 2026 menempatkan IWAG 2027 di Hotel Ciputra Jakarta, Jakarta Barat. Informasi jadwal program, tiket, dan pendaftaran belum dianggap final oleh pratinjau independen ini." : "The public announcement reviewed on 23 November 2026 places IWAG 2027 at Hotel Ciputra Jakarta, West Jakarta. Programme schedules, passes, and registration details are not treated as final by this independent preview."}</p>
      <p><a href="https://iwag.furries.id/en/" rel="external">{lang === "id" ? "Periksa situs acara sumber" : "Check the original event website"}</a></p>
      <p class="muted">{lang === "id" ? "Informasi edisi 2026 tersedia sebagai arsip historis dan tidak boleh dianggap sebagai jadwal atau kebijakan 2027." : "The 2026 edition is available as a historical archive and must not be treated as the 2027 schedule or policy."}</p>
    </section>}
    {isJoinTeam && <section class="conduct-content">
      <aside class="notice"><strong>{lang === "id" ? "Status pengumuman" : "Announcement status"}</strong><p>{lang === "id" ? "Halaman ini merangkum struktur kontribusi yang pernah diumumkan pada November 2026. Ini bukan formulir pendaftaran dan tidak mengonfirmasi bahwa lowongan masih tersedia." : "This page summarises contribution areas announced in November 2026. It is not an application form and does not confirm that vacancies remain open."}</p></aside>
      <h2>{lang === "id" ? "Bidang kontribusi" : "Contribution areas"}</h2>
      <ul><li><strong>Media</strong> — {lang === "id" ? "Fotografi, videografi, dokumentasi, dan koordinasi relawan media." : "Photography, videography, documentation, and media volunteer coordination."}</li><li><strong>Con Store and Dealers Den</strong> — {lang === "id" ? "Operasional toko acara dan dukungan hubungan dealer." : "Event-store operations and dealer relations support."}</li><li><strong>Logistics</strong> — {lang === "id" ? "Inventaris, perlengkapan, distribusi, dan dukungan lapangan." : "Inventory, equipment, distribution, and on-site support."}</li><li><strong>Attendee Services</strong> — {lang === "id" ? "Informasi dan dukungan peserta sebelum serta selama acara." : "Attendee information and support before and during the event."}</li><li><strong>Experience and Decoration</strong> — {lang === "id" ? "Pengalaman tematik, penataan ruang, dan dekorasi." : "Themed experiences, space planning, and decoration."}</li></ul>
      <h2>{lang === "id" ? "Staff dan volunteer" : "Staff and volunteers"}</h2>
      <p>{lang === "id" ? "Pengumuman sumber membedakan staff yang merencanakan dan bertanggung jawab atas hasil, dengan volunteer yang membantu pelaksanaan rencana saat acara. Persyaratan dan komitmen untuk setiap peran harus ditetapkan melalui pengumuman resmi yang masih berlaku." : "The source announcement distinguishes staff, who plan and own outcomes, from volunteers, who help execute plans during the event. Requirements and commitments for each role must be defined by a current official announcement."}</p>
      <p><a href={`/${lang}/join-iwag-team/roles`}>{lang === "id" ? "Jelajahi direktori peran" : "Explore the role directory"}</a></p>
      <p><a href="https://iwag.furries.id/en/updates/2026-11-08-staff-applications" rel="external">{lang === "id" ? "Buka pengumuman sumber" : "Open the original announcement"}</a></p>
    </section>}
    {isLinks && <section class="conduct-content">
      <h2>{lang === "id" ? "Sumber perjalanan resmi" : "Official travel resources"}</h2>
      <ul><li><a href="https://www.imigrasi.go.id/" rel="external">Directorate General of Immigration</a></li><li><a href="https://evisa.imigrasi.go.id/" rel="external">Official Indonesian e-Visa</a></li><li><a href="https://evisa.imigrasi.go.id/web/visa-selection" rel="external">Official visa category selector</a></li><li><a href="https://evisa.imigrasi.go.id/front/faq/aff9642b-0b57-443f-8de1-a51601de0ebb" rel="external">Visa activity and convention-attendee conditions</a></li><li><a href="https://allindonesia.imigrasi.go.id/" rel="external">All Indonesia arrival portal</a></li><li><a href="https://kemenimipas.go.id/berita-utama/mulai-1-oktober-deklarasi-kedatangan-penumpang-wajib-dilakukan-di-aplikasi-all-indonesia" rel="external">Ministry announcement on the unified arrival declaration</a></li><li><a href="https://www.beacukai.go.id/barang-penumpang" rel="external">Customs rules for passenger baggage</a></li><li><a href="https://www.beacukai.go.id/ecd" rel="external">Electronic Customs Declaration</a></li><li><a href="https://airport-train.kci.id/" rel="external">KAI Commuter airport train tickets</a></li><li><a href="https://soekarnohatta.injourneyairports.id/access/city-transportation/airport-train" rel="external">Soekarno-Hatta Airport train information</a></li><li><a href="https://www.jakarta.go.id/" rel="external">Jakarta Provincial Government</a></li></ul>
      <h2>{lang === "id" ? "Sumber venue" : "Venue resources"}</h2>
      <ul><li><a href="https://hotelciputra.com/jakarta/" rel="external">Hotel Ciputra Jakarta</a></li><li><a href="https://www.ciputramall.com/" rel="external">Mal Ciputra Jakarta</a></li></ul>
      <h2>{lang === "id" ? "Sumber acara" : "Event resources"}</h2>
      <ul><li><a href="https://iwag.furries.id/en/" rel="external">Original IWAG website</a></li><li><a href="https://iwag.furries.id/en/updates/" rel="external">Original IWAG updates</a></li><li><a href="https://iwag-archive.furries.id/en" rel="external">IWAG historical archive</a></li></ul>
      <p class="muted">{lang === "id" ? "Tautan eksternal mengarah ke situs pihak lain. Pratinjau ini tidak mengendalikan ketersediaan, kebijakan privasi, atau keamanan layanan eksternal." : "External links lead to third-party websites. This preview does not control their availability, privacy policies, or service security."}</p>
    </section>}
    {isPolicy && <section class="content-card">
      <h2>{lang === "id" ? "Rekonstruksi aturan acara" : "Reconstructed event rules"}</h2>
      <p>{lang === "id" ? "Dokumen berikut menyusun kembali ketentuan acara V1 menjadi aturan V2 yang lebih terstruktur: hak dan kewajiban peserta, registrasi dan pembayaran, keselamatan, perilaku, privasi, peran dealer dan program, serta mekanisme pelaporan dan peninjauan." : "The documents below reconstruct the V1 event rules as structured V2 provisions: attendee rights and duties, registration and payment, safety, conduct, privacy, dealer and programme roles, and reporting and review procedures."}</p>
      <ul>
        <li><a href={`/${lang}/terms/`}>{lang === "id" ? "Syarat dan Ketentuan" : "Terms and Conditions"}</a></li>
        <li><a href={`/${lang}/ruleset/`}>{lang === "id" ? "Aturan Penggunaan Situs" : "Website Ruleset"}</a></li>
        <li><a href={`/${lang}/code-of-conduct/`}>{lang === "id" ? "Kode Etik" : "Code of Conduct"}</a></li>
        <li><a href={`/${lang}/privacy/`}>{lang === "id" ? "Kebijakan Privasi" : "Privacy Policy"}</a></li>
        <li><a href={`/${lang}/cookies/`}>{lang === "id" ? "Kebijakan Cookie dan Penyimpanan Browser" : "Cookie & Browser Storage Policy"}</a></li>
        <li><a href={`/${lang}/copyright/`}>{lang === "id" ? "Hak Cipta dan Kekayaan Intelektual" : "Copyright & Intellectual Property"}</a></li>
        <li><a href={`/${lang}/disclaimer/`}>Disclaimer</a></li>
        <li><a href={`/${lang}/accessibility/`}>{lang === "id" ? "Pernyataan Aksesibilitas" : "Accessibility Statement"}</a></li>
        <li><a href={`/${lang}/moderation/`}>{lang === "id" ? "Moderasi dan Pelaporan" : "Moderation & Reporting"}</a></li>
        <li><a href={`/${lang}/retention/`}>{lang === "id" ? "Retensi Data" : "Data Retention"}</a></li>
      </ul>
      <p class="muted">{lang === "id" ? "Semua dokumen tetap berupa draf dan belum menjadi kebijakan final, kontrak, atau nasihat hukum. Identitas pengendali, kontak, dan proses operasional tidak akan dikarang." : "All documents remain drafts and are not final policies, contracts, or legal advice. Controller identity, contacts, and operational processes will not be invented."}</p>
    </section>}
    {isAbout && <section class="history-section" aria-label={lang === "id" ? "Sejarah pertemuan" : "Gathering history"}>
      <div class="history-entry"><span>2017</span><div><h2>{lang === "id" ? "Awal komunitas" : "Community beginnings"}</h2><p>{lang === "id" ? "Pertemuan akhir tahun Indonesia Winter Furmeet menjadi awal tradisi berkumpul." : "The year-end Indonesia Winter Furmeet meetups began a recurring tradition of bringing the community together."}</p></div></div>
      <div class="history-entry"><span>2022</span><div><h2>{lang === "id" ? "Pertemuan kembali" : "A renewed gathering"}</h2><p>{lang === "id" ? "IWFM kembali digelar dengan kegiatan komunitas, seni, permainan, dan sesi foto bersama." : "IWFM returned with community activities, art, games, and a group photo gathering."}</p></div></div>
      <div class="history-entry"><span>2023</span><div><h2>{lang === "id" ? "IWAG pertama" : "The first IWAG"}</h2><p>{lang === "id" ? "Format berkembang menjadi pertemuan akhir pekan dengan panggung, artist alley, panel, dan lounge." : "The format grew into a weekend gathering with a stage, artist alley, panels, and a casual lounge."}</p></div></div>
      <div class="history-entry"><span>2024</span><div><h2>{lang === "id" ? "Akhir pekan penuh" : "A full weekend format"}</h2><p>{lang === "id" ? "Acara memperluas program dan memperkenalkan sistem pengelolaan acara Community." : "The event expanded its programme and introduced the Community event-management platform."}</p></div></div>
    </section>}
    {isBrand && <section class="conduct-content">
      <aside class="notice"><strong>{lang === "id" ? "Catatan hak penggunaan" : "Usage and permissions"}</strong><p>{lang === "id" ? "Halaman sumber meminta pihak ketiga menghubungi IWAG untuk memperoleh persetujuan sebelum memakai logo. Proyek V2 ini tidak menyalin logo atau maskot." : "The source page asks third parties to contact IWAG and obtain approval before using its logo. This V2 project does not reproduce the logo or mascot artwork."}</p></aside>
      <section><h2>{lang === "id" ? "Logo dan identitas visual" : "Logo and visual identity"}</h2><p>{lang === "id" ? "Penggunaan logo dalam kegiatan kolaborasi memerlukan persetujuan terlebih dahulu. Pedoman sumber juga menekankan proporsi asli, ruang kosong, kontras latar, dan larangan mengubah bentuk atau memberi efek." : "Use of the logo in collaborative projects requires prior approval. The source guidelines also emphasise preserving proportions, clear space, background contrast, and avoiding distortion or visual effects."}</p></section>
      <section><h2>{lang === "id" ? "Karya karakter" : "Character artwork"}</h2><p>{lang === "id" ? "Sumber menyatakan ilustrasi Kiki dan Tama dilisensikan CC BY-NC 4.0 dengan atribusi kepada Reo. Ketentuan non-komersial dan atribusi harus diperhatikan; lisensi ini bukan izin penggunaan komersial." : "The source states that Kiki and Tama reference artwork is licensed under CC BY-NC 4.0 with attribution to Reo. The non-commercial and attribution conditions matter; this is not permission for commercial use."}</p><a href="https://creativecommons.org/licenses/by-nc/4.0/" rel="external">Creative Commons BY-NC 4.0</a></section>
      <p><a href="https://iwag.furries.id/en/brand" rel="external">{lang === "id" ? "Buka pedoman merek sumber" : "Open the original brand guidelines"}</a></p>
    </section>}
    {isDealers && <aside class="notice"><h2>{lang === "id" ? "Halaman sumber tidak tersedia" : "Source page unavailable"}</h2><p>{lang === "id" ? "Saat diperiksa pada 23 November 2026, rute Dealers mengembalikan halaman tidak ditemukan. V2 tidak akan mengarang daftar dealer atau formulir pendaftaran." : "When checked on 23 November 2026, the Dealers route returned a not-found page. V2 will not invent a dealer list or application form."}</p></aside>}
    {isLocation && <section class="content-card detail-grid">
      <div><p class="eyebrow">IWAG 2027 · VENUE</p><h2>Hotel Ciputra Jakarta</h2><p>West Jakarta, Indonesia</p><p>The published venue announcement describes event spaces grouped on the sixth floor, with a connection to Mal Ciputra Jakarta.</p><p><strong>Address</strong><br />Jl. Letnan Jenderal S Parman, Tanjung Duren, Grogol Petamburan, Jakarta 11470, Indonesia</p><p><a href="https://hotelciputra.com/jakarta/" rel="external">Hotel website</a></p></div>
      <div class="venue-visual venue-visual-detail" aria-hidden="true"><span>HOTEL CIPUTRA</span><strong>JKT</strong><small>WEST JAKARTA</small></div>
      <div class="detail-wide"><h2>Venue notes</h2><ul><li>Event spaces are announced on the sixth floor.</li><li>The venue connects to Mal Ciputra Jakarta.</li><li>The source announcement describes lift and escalator access through the mall connection.</li></ul><p class="muted">Travel guidance and access arrangements may change. Confirm transport, room reservations, and accessibility services with the official event and venue channels before travelling.</p><h2>Visitor guides</h2><ul><li><a href={`/${lang}/location/public-transit-guide/`}>Public transit guide</a></li><li><a href={`/${lang}/location/private-vehicles-guide/`}>Private vehicle guide (legacy warning)</a></li><li><a href={`/${lang}/international-travelers-guide/`}>International travelers guide</a></li></ul></div>
    </section>}
    {isParticipate && <section class="pass-grid">
      {[
        { name: "Aspirant", price: "IDR 350,000", note: "The entry tier for the two-day gathering.", perks: ["Convention badge", "Convention book", "Postcard", "Poster", "Basic lanyard", "Sticker pack"], availability: "Coming Soon" },
        { name: "Technician", price: "IDR 700,000", note: "Everything in Aspirant, plus:", perks: ["IWAG 2027 T-shirt", "Mascot pins", "Mascot keychains"], availability: "Coming Soon" },
        { name: "Preceptor", price: "IDR 1,100,000", note: "Everything in Technician, plus:", perks: ["Tote bag", "Coasters", "Mascot standee", "Custom convention badge", "Special lanyard", "Special ladder gift", "Convention book mention", "Early Dealers Den access", "Early badge pickup"], tag: "Best Value", limit: "Special ladder gifts unlock at 100, 150, 200, and 250 Preceptor passes. Early pickup is before Aspirant and Technician tiers.", availability: "Coming Soon" },
        { name: "Magister", price: "IDR 3,300,000", note: "Everything in Preceptor, plus:", perks: ["Fursona keychain", "YCH headshot by the IWAG Creative team", "Fursona nightstand", "Special acrylic convention badge", "Special goodie pack", "Super Sponsor lanyard", "Exclusive Super Sponsor gift", "Priority seating at main events", "No-queue Dealers Den access when capacity allows", "Second-priority hotel booking", "Hotel welcome amenities", "Special mentions", "Early and priority registration queue"], limit: "40 passes only. IWAG announced hotel booking priority emails five days before general booking opens.", availability: "Coming Soon" },
