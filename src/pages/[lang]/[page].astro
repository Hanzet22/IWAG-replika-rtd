---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMessages } from "../../i18n/ui";
import { isLocale, localeKeys } from "../../i18n/locales";

const pageTitles: Record<string, Record<string, string>> = {
  en: {
    about: "About this project", accessibility: "Accessibility", brand: "Brand resources",
    coc: "Code of Conduct", "code-of-conduct": "Code of Conduct", dealers: "Dealers",
    events: "Events", "join-iwag-team": "Join the team", links: "Links",
    location: "Location", participate: "Participate", policy: "Policies",
    privacy: "Privacy", terms: "Terms", tnc: "Terms and Conditions", updates: "Updates"
  },
  id: {
    about: "Tentang proyek ini", accessibility: "Aksesibilitas", brand: "Sumber daya merek",
    coc: "Kode Etik", "code-of-conduct": "Kode Etik", dealers: "Dealer",
    events: "Acara", "join-iwag-team": "Bergabung dengan tim", links: "Tautan",
    location: "Lokasi", participate: "Partisipasi", policy: "Kebijakan",
    privacy: "Privasi", terms: "Ketentuan", tnc: "Syarat dan Ketentuan", updates: "Pembaruan"
  },
  "en-sg": {
    about: "About this project", accessibility: "Accessibility", brand: "Brand resources",
    coc: "Code of Conduct", "code-of-conduct": "Code of Conduct", dealers: "Dealers",
    events: "Events", "join-iwag-team": "Join the team", links: "Links",
    location: "Location", participate: "Participate", policy: "Policies",
    privacy: "Privacy", terms: "Terms", tnc: "Terms and Conditions", updates: "Updates"
  },
  "ms-my": {
    about: "Perihal projek ini", accessibility: "Kebolehcapaian", brand: "Sumber jenama",
    coc: "Kod Tatakelakuan", "code-of-conduct": "Kod Tatakelakuan", dealers: "Peniaga",
    events: "Acara", "join-iwag-team": "Sertai pasukan", links: "Pautan",
    location: "Lokasi", participate: "Penyertaan", policy: "Dasar",
    privacy: "Privasi", terms: "Terma", tnc: "Terma dan Syarat", updates: "Kemas kini"
  }
};

export function getStaticPaths() {
  const pageKeys = [
    "about", "accessibility", "brand", "coc", "code-of-conduct", "dealers",
    "events", "join-iwag-team", "links", "location", "participate", "policy",
    "privacy", "terms", "tnc", "updates"
  ] as const;
  return localeKeys.flatMap((lang) => pageKeys.map((page) => ({ params: { lang, page } })));
}

const langParam = Astro.params.lang;
const page = Astro.params.page ?? "about";
const lang = isLocale(langParam) ? langParam : "en";
const t = getMessages(lang);
const title = pageTitles[lang]?.[page] ?? pageTitles.en[page] ?? "Information";
const legalPages = ["terms", "tnc", "privacy", "coc", "code-of-conduct"];
const isLegal = legalPages.includes(page);
const isAccessibility = page === "accessibility";
const isAbout = page === "about";
const isLocation = page === "location";
const isParticipate = page === "participate";
const isUpdates = page === "updates";
const copy = isLegal ? t.legalDraft
  : isAccessibility ? t.levelText
  : isAbout ? (lang === "id"
      ? "IWAG V2 adalah rekayasa ulang independen dari arsip referensi. Proyek ini berfokus pada informasi yang mudah dibaca, navigasi konsisten, aksesibilitas, dan minimisasi data."
      : "IWAG V2 is an independent re-engineering project based on a separately archived reference. It focuses on readable information, predictable navigation, accessibility, and data minimisation.")
  : t.notPublished;
---
<BaseLayout lang={lang} title={title} description={copy}>
  <article class="page-content">
    <p class="eyebrow">IWAG V2 · Independent project</p>
    <h1>{title}</h1>
    <p class="lead">{copy}</p>
    {isAbout && <section class="history-section" aria-label={lang === "id" ? "Sejarah pertemuan" : "Gathering history"}>
      <div class="history-entry"><span>2017</span><div><h2>{lang === "id" ? "Awal komunitas" : "Community beginnings"}</h2><p>{lang === "id" ? "Pertemuan akhir tahun Indonesia Winter Furmeet menjadi awal tradisi berkumpul." : "The year-end Indonesia Winter Furmeet meetups began a recurring tradition of bringing the community together."}</p></div></div>
      <div class="history-entry"><span>2022</span><div><h2>{lang === "id" ? "Pertemuan kembali" : "A renewed gathering"}</h2><p>{lang === "id" ? "IWFM kembali digelar dengan kegiatan komunitas, seni, permainan, dan sesi foto bersama." : "IWFM returned with community activities, art, games, and a group photo gathering."}</p></div></div>
      <div class="history-entry"><span>2023</span><div><h2>{lang === "id" ? "IWAG pertama" : "The first IWAG"}</h2><p>{lang === "id" ? "Format berkembang menjadi pertemuan akhir pekan dengan panggung, artist alley, panel, dan lounge." : "The format grew into a weekend gathering with a stage, artist alley, panels, and a casual lounge."}</p></div></div>
      <div class="history-entry"><span>2024</span><div><h2>{lang === "id" ? "Akhir pekan penuh" : "A full weekend format"}</h2><p>{lang === "id" ? "Acara memperluas program dan memperkenalkan sistem pengelolaan acara Community." : "The event expanded its programme and introduced the Community event-management platform."}</p></div></div>
    </section>}
    {isLocation && <section class="content-card detail-grid">
      <div><p class="eyebrow">IWAG 2027 · VENUE</p><h2>Hotel Ciputra Jakarta</h2><p>West Jakarta, Indonesia</p><p>The published venue announcement describes event spaces grouped on the sixth floor, with a connection to Mal Ciputra Jakarta.</p><p><strong>Address</strong><br />Jl. Letnan Jenderal S Parman, Tanjung Duren, Grogol Petamburan, Jakarta 11470, Indonesia</p><p><a href="https://hotelciputra.com/jakarta/" rel="external">Hotel website</a></p></div>
      <div class="venue-visual venue-visual-detail" aria-hidden="true"><span>HOTEL CIPUTRA</span><strong>JKT</strong><small>WEST JAKARTA</small></div>
      <div class="detail-wide"><h2>Venue notes</h2><ul><li>Event spaces are announced on the sixth floor.</li><li>The venue connects to Mal Ciputra Jakarta.</li><li>The source announcement describes lift and escalator access through the mall connection.</li></ul><p class="muted">Travel guidance and access arrangements may change. Confirm transport, room reservations, and accessibility services with the official event and venue channels before travelling.</p></div>
    </section>}
    {isParticipate && <section class="pass-grid">
      {[
        { name: "Aspirant", price: "IDR 350,000", note: "Basic event merchandise and attendee materials", perks: ["Con badge", "Con book", "Postcard and poster", "Basic lanyard", "Sticker pack"] },
        { name: "Technician", price: "IDR 700,000", note: "Aspirant items plus additional themed merchandise", perks: ["IWAG 2027 T-shirt", "Mascot pins", "Mascot keychains"] },
        { name: "Preceptor", price: "IDR 1,100,000", note: "Expanded merchandise and early-access benefits", perks: ["Tote bag and coasters", "Mascot standee", "Custom con badge", "Early Dealers Den access", "Early badge pickup"] },
        { name: "Super Sponsor", price: "IDR 3,300,000", note: "Limited tier with additional sponsor benefits", perks: ["Fursona keychain and YCH headshot", "Special acrylic badge and gift pack", "Priority main-event seating", "Hotel booking priority"] },
        { name: "Benefactor", price: "IDR 9,900,000", note: "Limited raffle-based tier with premium inclusions", perks: ["Custom full-body art", "Fursona standee", "Deluxe room stay (4 days / 3 nights)", "Special experiences and media inclusion"] }
      ].map((tier) => <article class="pass-card"><p class="eyebrow">EVENT PASS TIER</p><h2>{tier.name}</h2><p class="pass-price">{tier.price}</p><p>{tier.note}</p><ul>{tier.perks.map((perk) => <li>{perk}</li>)}</ul><span class="pass-status">Coming soon · Source snapshot</span></article>)}
      <p class="detail-wide muted">Prices and benefit summaries reflect the public participation page captured on 23 November 2026. All tiers were marked “Coming Soon” on that date. Benefits, limits, and availability can change; verify the official page before making decisions. This independent preview does not sell or reserve passes.</p>
    </section>}
    {isUpdates && <section class="update-grid update-grid-page">
      {[
        { date: "15 November 2026", title: "Welcome to West Jakarta", summary: "The 2027 gathering announces Hotel Ciputra Jakarta as its new venue.", href: "https://iwag.furries.id/en/updates/2026-11-15-venue-reveal" },
        { date: "8 November 2026", title: "Join our Team!", summary: "A public call for people interested in contributing to the event team.", href: "https://iwag.furries.id/en/updates/2026-11-08-staff-applications" },
        { date: "14 July 2026", title: "IWAG 2026 — Memories from You and Our Team", summary: "A retrospective following the 2026 gathering.", href: "https://iwag.furries.id/en/updates/2026-07-14-conclusion" }
      ].map((item) => <article class="update-card"><span class="update-date">{item.date}</span><h2>{item.title}</h2><p>{item.summary}</p><a href={item.href} rel="external">Open original announcement</a></article>)}
    </section>}
    {isAccessibility && <section class="content-card">
      <h2>{t.level}</h2>
      <p>{t.levelText}</p>
      <p>{lang === "id" ? "Target Level A tidak berarti halaman ini telah lulus audit. Pengujian manual dan teknologi bantu masih diperlukan." : "A Level A target does not mean this page has passed an audit. Manual and assistive-technology review is still required."}</p>
      <h2>{lang === "id" ? "Komitmen desain V2" : "V2 design commitments"}</h2>
      <ul>
        <li>{lang === "id" ? "Tidak ada tindakan penting yang mewajibkan pengguna berbicara atau memakai suara." : "No essential action will require speech or voice input."}</li>
        <li>{lang === "id" ? "Informasi penting tidak disampaikan melalui warna saja." : "Important information will never be conveyed through colour alone."}</li>
        <li>{lang === "id" ? "Media audio-visual yang diterbitkan harus menyediakan caption atau transkrip yang sesuai." : "Published audiovisual media must provide suitable captions or transcripts."}</li>
        <li>{lang === "id" ? "Animasi dekoratif tidak berjalan otomatis dan menghormati preferensi reduced motion." : "Decorative motion does not autoplay and respects reduced-motion preferences."}</li>
        <li>{lang === "id" ? "Informasi dan navigasi utama tetap tersedia tanpa JavaScript." : "Core information and navigation remain available without JavaScript."}</li>
      </ul>
      <p class="muted">{lang === "id" ? "Kanal kontak berbasis teks dan akomodasi acara akan diterbitkan setelah alamat kontak serta layanan pendukung diverifikasi." : "Text-based contact channels and event accommodations will be published after contact details and support services are verified."}</p>
    </section>}
    {isLegal && <aside class="notice"><h2>{lang === "id" ? "Belum disahkan" : "Not approved"}</h2><p>{copy}</p></aside>}
    {!isLegal && !isAccessibility && !isLocation && !isParticipate && !isUpdates && <aside class="notice"><p>{lang === "id" ? "Informasi acara dan operasional akan diterbitkan setelah sumbernya diverifikasi. Arsip V1 tidak dianggap sebagai informasi terkini." : "Event and operational information will be published only after its source is verified. V1 archive material is not treated as current information."}</p></aside>}
  </article>
</BaseLayout>
