---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getMessages } from "../../i18n/ui";
import { isLocale, localeKeys } from "../../i18n/locales";

const pageTitles: Record<string, Record<string, string>> = {
  en: {
    about: "About this project", accessibility: "Accessibility", brand: "Brand resources",
    coc: "Code of Conduct", "code-of-conduct": "Code of Conduct", dealers: "Dealers",
    events: "Events", "join-iwag-team": "Join the team", links: "Links",
    location: "Location", participate: "Participate", policy: "Policies",
    privacy: "Privacy", terms: "Terms", tnc: "Terms and Conditions", updates: "Updates"
  },
  id: {
    about: "Tentang proyek ini", accessibility: "Aksesibilitas", brand: "Sumber daya merek",
    coc: "Kode Etik", "code-of-conduct": "Kode Etik", dealers: "Dealer",
    events: "Acara", "join-iwag-team": "Bergabung dengan tim", links: "Tautan",
    location: "Lokasi", participate: "Partisipasi", policy: "Kebijakan",
    privacy: "Privasi", terms: "Ketentuan", tnc: "Syarat dan Ketentuan", updates: "Pembaruan"
  },
  "en-sg": {
    about: "About this project", accessibility: "Accessibility", brand: "Brand resources",
    coc: "Code of Conduct", "code-of-conduct": "Code of Conduct", dealers: "Dealers",
    events: "Events", "join-iwag-team": "Join the team", links: "Links",
    location: "Location", participate: "Participate", policy: "Policies",
    privacy: "Privacy", terms: "Terms", tnc: "Terms and Conditions", updates: "Updates"
  },
  "ms-my": {
    about: "Perihal projek ini", accessibility: "Kebolehcapaian", brand: "Sumber jenama",
    coc: "Kod Tatakelakuan", "code-of-conduct": "Kod Tatakelakuan", dealers: "Peniaga",
    events: "Acara", "join-iwag-team": "Sertai pasukan", links: "Pautan",
    location: "Lokasi", participate: "Penyertaan", policy: "Dasar",
    privacy: "Privasi", terms: "Terma", tnc: "Terma dan Syarat", updates: "Kemas kini"
  }
};

export function getStaticPaths() {
  const pageKeys = [
    "about", "accessibility", "brand", "coc", "code-of-conduct", "dealers",
    "events", "join-iwag-team", "links", "location", "participate", "policy",
    "privacy", "terms", "tnc", "updates"
  ] as const;
  return localeKeys.flatMap((lang) => pageKeys.map((page) => ({ params: { lang, page } })));
}

const langParam = Astro.params.lang;
const page = Astro.params.page ?? "about";
const lang = isLocale(langParam) ? langParam : "en";
const t = getMessages(lang);
const title = pageTitles[lang]?.[page] ?? pageTitles.en[page] ?? "Information";
const legalPages = ["terms", "tnc", "privacy", "coc", "code-of-conduct"];
const isLegal = legalPages.includes(page);
const isAccessibility = page === "accessibility";
const isAbout = page === "about";
const isLocation = page === "location";
const isParticipate = page === "participate";
const isUpdates = page === "updates";
const isConduct = page === "coc" || page === "code-of-conduct";
const isBrand = page === "brand";
const isDealers = page === "dealers";
const isEvents = page === "events";
const isJoinTeam = page === "join-iwag-team";
const isLinks = page === "links";
const isPolicy = page === "policy";
const copy = isConduct
  ? (lang === "id" ? "Ringkasan referensi dari halaman Code of Conduct sumber. Ini bukan kebijakan V2 yang disahkan atau instruksi resmi untuk menghadiri acara." : "A reference summary of the source Code of Conduct page. This is not an approved V2 policy or official event-attendance instruction.")
  : isLegal ? t.legalDraft
  : isAccessibility ? t.levelText
  : isAbout ? (lang === "id"
      ? "IWAG V2 adalah rekayasa ulang independen dari arsip referensi. Proyek ini berfokus pada informasi yang mudah dibaca, navigasi konsisten, aksesibilitas, dan minimisasi data."
      : "IWAG V2 is an independent re-engineering project based on a separately archived reference. It focuses on readable information, predictable navigation, accessibility, and data minimisation.")
  : t.notPublished;
---
<BaseLayout lang={lang} title={title} description={copy}>
  <article class="page-content">
    <p class="eyebrow">IWAG V2 · Independent project</p>
    <h1>{title}</h1>
    <p class="lead">{copy}</p>
    {isEvents && <section class="content-card">
      <p class="eyebrow">IWAG 2027 · FANTASTIC ARCANA</p>
      <h2>3–4 July 2027</h2>
      <h3>Hotel Ciputra Jakarta</h3>
      <p>{lang === "id" ? "Pengumuman publik yang diperiksa pada 23 November 2026 menempatkan IWAG 2027 di Hotel Ciputra Jakarta, Jakarta Barat. Informasi jadwal program, tiket, dan pendaftaran belum dianggap final oleh pratinjau independen ini." : "The public announcement reviewed on 23 November 2026 places IWAG 2027 at Hotel Ciputra Jakarta, West Jakarta. Programme schedules, passes, and registration details are not treated as final by this independent preview."}</p>
      <p><a href="https://iwag.furries.id/en/" rel="external">{lang === "id" ? "Periksa situs acara sumber" : "Check the original event website"}</a></p>
      <p class="muted">{lang === "id" ? "Informasi edisi 2026 tersedia sebagai arsip historis dan tidak boleh dianggap sebagai jadwal atau kebijakan 2027." : "The 2026 edition is available as a historical archive and must not be treated as the 2027 schedule or policy."}</p>
    </section>}
    {isJoinTeam && <section class="conduct-content">
      <aside class="notice"><strong>{lang === "id" ? "Status pengumuman" : "Announcement status"}</strong><p>{lang === "id" ? "Halaman ini merangkum struktur kontribusi yang pernah diumumkan pada November 2026. Ini bukan formulir pendaftaran dan tidak mengonfirmasi bahwa lowongan masih tersedia." : "This page summarises contribution areas announced in November 2026. It is not an application form and does not confirm that vacancies remain open."}</p></aside>
      <h2>{lang === "id" ? "Bidang kontribusi" : "Contribution areas"}</h2>
      <ul><li><strong>Media</strong> — {lang === "id" ? "Fotografi, videografi, dokumentasi, dan koordinasi relawan media." : "Photography, videography, documentation, and media volunteer coordination."}</li><li><strong>Con Store and Dealers Den</strong> — {lang === "id" ? "Operasional toko acara dan dukungan hubungan dealer." : "Event-store operations and dealer relations support."}</li><li><strong>Logistics</strong> — {lang === "id" ? "Inventaris, perlengkapan, distribusi, dan dukungan lapangan." : "Inventory, equipment, distribution, and on-site support."}</li><li><strong>Attendee Services</strong> — {lang === "id" ? "Informasi dan dukungan peserta sebelum serta selama acara." : "Attendee information and support before and during the event."}</li><li><strong>Experience and Decoration</strong> — {lang === "id" ? "Pengalaman tematik, penataan ruang, dan dekorasi." : "Themed experiences, space planning, and decoration."}</li></ul>
      <h2>{lang === "id" ? "Staff dan volunteer" : "Staff and volunteers"}</h2>
      <p>{lang === "id" ? "Pengumuman sumber membedakan staff yang merencanakan dan bertanggung jawab atas hasil, dengan volunteer yang membantu pelaksanaan rencana saat acara. Persyaratan dan komitmen untuk setiap peran harus ditetapkan melalui pengumuman resmi yang masih berlaku." : "The source announcement distinguishes staff, who plan and own outcomes, from volunteers, who help execute plans during the event. Requirements and commitments for each role must be defined by a current official announcement."}</p>
      <p><a href={`/${lang}/join-iwag-team/roles`}>{lang === "id" ? "Jelajahi direktori peran" : "Explore the role directory"}</a></p>
      <p><a href="https://iwag.furries.id/en/updates/2026-11-08-staff-applications" rel="external">{lang === "id" ? "Buka pengumuman sumber" : "Open the original announcement"}</a></p>
    </section>}
    {isLinks && <section class="conduct-content">
      <h2>{lang === "id" ? "Sumber perjalanan resmi" : "Official travel resources"}</h2>
      <ul><li><a href="https://www.imigrasi.go.id/" rel="external">Directorate General of Immigration</a></li><li><a href="https://evisa.imigrasi.go.id/" rel="external">Official Indonesian e-Visa</a></li><li><a href="https://allindonesia.imigrasi.go.id/" rel="external">All Indonesia arrival portal</a></li><li><a href="https://www.kai.id/" rel="external">KAI passenger services</a></li><li><a href="https://www.jakarta.go.id/" rel="external">Jakarta Provincial Government</a></li></ul>
      <h2>{lang === "id" ? "Sumber venue" : "Venue resources"}</h2>
      <ul><li><a href="https://hotelciputra.com/jakarta/" rel="external">Hotel Ciputra Jakarta</a></li><li><a href="https://www.ciputramall.com/" rel="external">Mal Ciputra Jakarta</a></li></ul>
      <h2>{lang === "id" ? "Sumber acara" : "Event resources"}</h2>
      <ul><li><a href="https://iwag.furries.id/en/" rel="external">Original IWAG website</a></li><li><a href="https://iwag.furries.id/en/updates/" rel="external">Original IWAG updates</a></li><li><a href="https://iwag-archive.furries.id/en" rel="external">IWAG historical archive</a></li></ul>
      <p class="muted">{lang === "id" ? "Tautan eksternal mengarah ke situs pihak lain. Pratinjau ini tidak mengendalikan ketersediaan, kebijakan privasi, atau keamanan layanan eksternal." : "External links lead to third-party websites. This preview does not control their availability, privacy policies, or service security."}</p>
    </section>}
    {isPolicy && <section class="content-card">
      <h2>{lang === "id" ? "Dokumen tata kelola V2" : "V2 governance documents"}</h2>
      <p>{lang === "id" ? "Dokumen kebijakan V2 akan ditulis ulang berdasarkan operasi nyata, tanggung jawab pihak terkait, dan aturan lintas yurisdiksi yang relevan. Arsip V1 bukan sumber otomatis untuk ketentuan V2." : "V2 policy documents will be rewritten around actual operations, stakeholder responsibilities, and relevant cross-jurisdictional rules. The V1 archive is not an automatic source for V2 terms."}</p>
      <ul><li><a href={`/${lang}/terms/`}>{lang === "id" ? "Syarat dan Ketentuan" : "Terms and Conditions"}</a></li><li><a href={`/${lang}/code-of-conduct/`}>{lang === "id" ? "Kode Etik" : "Code of Conduct"}</a></li><li><a href={`/${lang}/privacy/`}>{lang === "id" ? "Kebijakan Privasi" : "Privacy Policy"}</a></li></ul>
      <p class="muted">{lang === "id" ? "Belum ada dokumen yang disajikan sebagai kebijakan final atau nasihat hukum. Tidak ada identitas pengendali data, badan hukum, atau proses operasional yang akan dikarang." : "No document is presented as a final policy or legal advice. No data-controller identity, legal entity, or operational process will be invented."}</p>
    </section>}
    {isAbout && <section class="history-section" aria-label={lang === "id" ? "Sejarah pertemuan" : "Gathering history"}>
      <div class="history-entry"><span>2017</span><div><h2>{lang === "id" ? "Awal komunitas" : "Community beginnings"}</h2><p>{lang === "id" ? "Pertemuan akhir tahun Indonesia Winter Furmeet menjadi awal tradisi berkumpul." : "The year-end Indonesia Winter Furmeet meetups began a recurring tradition of bringing the community together."}</p></div></div>
      <div class="history-entry"><span>2022</span><div><h2>{lang === "id" ? "Pertemuan kembali" : "A renewed gathering"}</h2><p>{lang === "id" ? "IWFM kembali digelar dengan kegiatan komunitas, seni, permainan, dan sesi foto bersama." : "IWFM returned with community activities, art, games, and a group photo gathering."}</p></div></div>
      <div class="history-entry"><span>2023</span><div><h2>{lang === "id" ? "IWAG pertama" : "The first IWAG"}</h2><p>{lang === "id" ? "Format berkembang menjadi pertemuan akhir pekan dengan panggung, artist alley, panel, dan lounge." : "The format grew into a weekend gathering with a stage, artist alley, panels, and a casual lounge."}</p></div></div>
      <div class="history-entry"><span>2024</span><div><h2>{lang === "id" ? "Akhir pekan penuh" : "A full weekend format"}</h2><p>{lang === "id" ? "Acara memperluas program dan memperkenalkan sistem pengelolaan acara Community." : "The event expanded its programme and introduced the Community event-management platform."}</p></div></div>
    </section>}
    {isBrand && <section class="conduct-content">
      <aside class="notice"><strong>{lang === "id" ? "Catatan hak penggunaan" : "Usage and permissions"}</strong><p>{lang === "id" ? "Halaman sumber meminta pihak ketiga menghubungi IWAG untuk memperoleh persetujuan sebelum memakai logo. Proyek V2 ini tidak menyalin logo atau maskot." : "The source page asks third parties to contact IWAG and obtain approval before using its logo. This V2 project does not reproduce the logo or mascot artwork."}</p></aside>
      <section><h2>{lang === "id" ? "Logo dan identitas visual" : "Logo and visual identity"}</h2><p>{lang === "id" ? "Penggunaan logo dalam kegiatan kolaborasi memerlukan persetujuan terlebih dahulu. Pedoman sumber juga menekankan proporsi asli, ruang kosong, kontras latar, dan larangan mengubah bentuk atau memberi efek." : "Use of the logo in collaborative projects requires prior approval. The source guidelines also emphasise preserving proportions, clear space, background contrast, and avoiding distortion or visual effects."}</p></section>
      <section><h2>{lang === "id" ? "Karya karakter" : "Character artwork"}</h2><p>{lang === "id" ? "Sumber menyatakan ilustrasi Kiki dan Tama dilisensikan CC BY-NC 4.0 dengan atribusi kepada Reo. Ketentuan non-komersial dan atribusi harus diperhatikan; lisensi ini bukan izin penggunaan komersial." : "The source states that Kiki and Tama reference artwork is licensed under CC BY-NC 4.0 with attribution to Reo. The non-commercial and attribution conditions matter; this is not permission for commercial use."}</p><a href="https://creativecommons.org/licenses/by-nc/4.0/" rel="external">Creative Commons BY-NC 4.0</a></section>
      <p><a href="https://iwag.furries.id/en/brand" rel="external">{lang === "id" ? "Buka pedoman merek sumber" : "Open the original brand guidelines"}</a></p>
    </section>}
    {isDealers && <aside class="notice"><h2>{lang === "id" ? "Halaman sumber tidak tersedia" : "Source page unavailable"}</h2><p>{lang === "id" ? "Saat diperiksa pada 23 November 2026, rute Dealers mengembalikan halaman tidak ditemukan. V2 tidak akan mengarang daftar dealer atau formulir pendaftaran." : "When checked on 23 November 2026, the Dealers route returned a not-found page. V2 will not invent a dealer list or application form."}</p></aside>}
    {isConduct && <section class="conduct-content">
      <aside class="notice"><strong>{lang === "id" ? "Snapshot referensi — 23 November 2026" : "Reference snapshot — 23 November 2026"}</strong><p>{lang === "id" ? "Ketentuan asli dapat berubah. Ringkasan ini dibuat untuk merekonstruksi struktur informasi, bukan menggantikan dokumen resmi atau menciptakan aturan baru." : "The source rules may change. This summary reconstructs the information structure; it does not replace the official document or create new event rules."}</p></aside>
      <section><h2>{lang === "id" ? "Usia dan pendampingan" : "Age and supervision"}</h2><p>{lang === "id" ? "Halaman sumber menyatakan acara ditujukan bagi usia 14 tahun ke atas. Peserta usia 14–16 memerlukan persetujuan orang tua/wali; peserta di bawah 14 harus selalu didampingi wali yang sah. Periksa dokumen sumber untuk ketentuan rinci dan perubahan." : "The source page states that the event is intended for ages 14 and above. Attendees aged 14–16 require parent or guardian consent; attendees under 14 must remain accompanied by a legal guardian. Consult the source document for full details and changes."}</p></section>
      <section><h2>{lang === "id" ? "Saling menghormati" : "Respect and conduct"}</h2><ul><li>{lang === "id" ? "Perlakukan peserta lain dengan hormat dan jangan melakukan pelecehan atau diskriminasi." : "Treat other attendees respectfully; harassment and discrimination are not accepted."}</li><li>{lang === "id" ? "Jaga konten dan perilaku tetap sesuai lingkungan acara yang ramah remaja." : "Keep content and behaviour appropriate for a teen-friendly event environment."}</li><li>{lang === "id" ? "Ikuti arahan petugas acara dan aturan fasilitas venue." : "Follow event-staff instructions and venue facility rules."}</li><li>{lang === "id" ? "Jaga kebersihan, properti, serta ruang bersama." : "Respect shared spaces, property, and cleanliness."}</li></ul></section>
      <section><h2>{lang === "id" ? "Privasi, foto, dan perekaman" : "Privacy, photos, and recording"}</h2><ul><li>{lang === "id" ? "Minta izin sebelum memotret atau merekam orang lain." : "Ask before photographing or recording other people."}</li><li>{lang === "id" ? "Hormati area yang melarang fotografi, termasuk lounge khusus." : "Respect areas where photography is restricted, including designated lounges."}</li><li>{lang === "id" ? "Hormati permintaan privasi dan jangan membagikan momen pribadi orang lain." : "Respect privacy requests and do not share other people's private moments."}</li></ul></section>
      <section><h2>{lang === "id" ? "Keselamatan dan fasilitas" : "Safety and facilities"}</h2><ul><li>{lang === "id" ? "Patuhi kebijakan venue mengenai fasilitas, kebisingan, dan area terbatas." : "Follow venue policies on facilities, noise, and restricted areas."}</li><li>{lang === "id" ? "Perlengkapan atau properti yang memerlukan pemeriksaan harus mengikuti prosedur pemeriksaan acara." : "Props or equipment requiring inspection must follow the event's inspection process."}</li><li>{lang === "id" ? "Laporkan masalah kepada petugas acara atau pihak venue yang berwenang." : "Report concerns to event staff or the appropriate venue personnel."}</li></ul></section>
      <p><a href="https://iwag.furries.id/en/coc" rel="external">{lang === "id" ? "Buka Code of Conduct sumber" : "Open the original Code of Conduct"}</a></p>
    </section>}
    {isLocation && <section class="content-card detail-grid">
      <div><p class="eyebrow">IWAG 2027 · VENUE</p><h2>Hotel Ciputra Jakarta</h2><p>West Jakarta, Indonesia</p><p>The published venue announcement describes event spaces grouped on the sixth floor, with a connection to Mal Ciputra Jakarta.</p><p><strong>Address</strong><br />Jl. Letnan Jenderal S Parman, Tanjung Duren, Grogol Petamburan, Jakarta 11470, Indonesia</p><p><a href="https://hotelciputra.com/jakarta/" rel="external">Hotel website</a></p></div>
      <div class="venue-visual venue-visual-detail" aria-hidden="true"><span>HOTEL CIPUTRA</span><strong>JKT</strong><small>WEST JAKARTA</small></div>
      <div class="detail-wide"><h2>Venue notes</h2><ul><li>Event spaces are announced on the sixth floor.</li><li>The venue connects to Mal Ciputra Jakarta.</li><li>The source announcement describes lift and escalator access through the mall connection.</li></ul><p class="muted">Travel guidance and access arrangements may change. Confirm transport, room reservations, and accessibility services with the official event and venue channels before travelling.</p></div>
    </section>}
    {isParticipate && <section class="pass-grid">
      {[
        { name: "Aspirant", price: "IDR 350,000", note: "Basic event merchandise and attendee materials", perks: ["Con badge", "Con book", "Postcard and poster", "Basic lanyard", "Sticker pack"] },
        { name: "Technician", price: "IDR 700,000", note: "Aspirant items plus additional themed merchandise", perks: ["IWAG 2027 T-shirt", "Mascot pins", "Mascot keychains"] },
        { name: "Preceptor", price: "IDR 1,100,000", note: "Expanded merchandise and early-access benefits", perks: ["Tote bag and coasters", "Mascot standee", "Custom con badge", "Early Dealers Den access", "Early badge pickup"] },
        { name: "Magister", price: "IDR 3,300,000", note: "Limited tier with additional sponsor benefits", perks: ["Fursona keychain and YCH headshot", "Special acrylic badge and gift pack", "Priority main-event seating", "Hotel booking priority"] },
        { name: "Eternal", price: "IDR 9,900,000", note: "Limited raffle-based tier with premium inclusions", perks: ["Custom full-body art", "Fursona standee", "Deluxe room stay (4 days / 3 nights)", "Special experiences and media inclusion"] }
      ].map((tier) => <article class="pass-card"><p class="eyebrow">EVENT PASS TIER</p><h2>{tier.name}</h2><p class="pass-price">{tier.price}</p><p>{tier.note}</p><ul>{tier.perks.map((perk) => <li>{perk}</li>)}</ul><span class="pass-status">Coming soon · Source snapshot</span></article>)}
      <p class="detail-wide muted">Prices and benefit summaries reflect the public participation page captured on 23 November 2026. All tiers were marked “Coming Soon” on that date. Benefits, limits, and availability can change; verify the official page before making decisions. This independent preview does not sell or reserve passes.</p>
    </section>}
    {isUpdates && <section class="update-grid update-grid-page">
      {[
        { date: "15 November 2026", title: "Welcome to West Jakarta", summary: "Hotel Ciputra Jakarta is announced as the venue for IWAG 2027.", href: "https://iwag.furries.id/en/updates/2026-11-15-venue-reveal" },
        { date: "8 November 2026", title: "Join our Team!", summary: "A call for community members interested in staff roles for the next gathering.", href: "https://iwag.furries.id/en/updates/2026-11-08-staff-applications" },
        { date: "14 July 2026", title: "IWAG 2026 — Memories from You and Our Team", summary: "A post-event retrospective, feedback invitation, and links to community media archives.", href: "https://iwag.furries.id/en/updates/2026-07-14-conclusion" },
        { date: "5 June 2026", title: "Welcome to the Fureats Café!", summary: "A dedicated café experience announced for the 2026 gathering; historical schedule only.", href: "https://iwag.furries.id/en/updates/2026-06-05-furcafe" },
        { date: "14 March 2026", title: "Introducing the IWAG Art Show", summary: "A gallery and auction format for community-created artwork at IWAG 2026.", href: "https://iwag.furries.id/en/updates/2026-03-14-art-show" },
        { date: "13 March 2026", title: "IWAG 2026 Conbook Applications", summary: "A historical call for community artwork submissions to the convention book.", href: "https://iwag.furries.id/en/updates/2026-03-13-conbook" },
        { date: "16 February 2026", title: "IWAG 2026 Talent Show Applications Open", summary: "A historical call for solo and group performance submissions.", href: "https://iwag.furries.id/en/updates/2026-02-16-talent-show" },
        { date: "31 January 2026", title: "IWAG 2026 Panel and Activity Applications", summary: "A historical invitation for entertainment, social, and educational sessions.", href: "https://iwag.furries.id/en/updates/2026-01-13-panel-registration" },
        { date: "28 January 2026", title: "Dealers Den Applications for IWAG 2026", summary: "A historical call for vendors, community representatives, and display creators.", href: "https://iwag.furries.id/en/updates/2026-01-28-dealers" },
        { date: "24 January 2026", title: "Volunteer Applications for IWAG 2026", summary: "A historical volunteer recruitment announcement for event operations.", href: "https://iwag.furries.id/en/updates/2026-01-24-volunteer" },
        { date: "20 December 2025", title: "IWAG 2026 Event Pass Registration Starts 3 January", summary: "Historical registration schedule and raffle information for the 2026 edition.", href: "https://iwag.furries.id/en/updates/2025-12-20-registration-information" },
        { date: "19 December 2025", title: "We Have Updated our Policies", summary: "A historical notice describing V1 policy revisions; not adopted as V2 policy.", href: "https://iwag.furries.id/en/updates/2025-12-19-updated-policies" },
        { date: "15 November 2025", title: "IWAG 2026: Event Pass Reveal", summary: "The five-tier pass announcement for the 2026 edition.", href: "https://iwag.furries.id/en/updates/2025-11-15-event-pass-reveal" },
        { date: "20 September 2025", title: "IWAG 2026: Electric Dreams", summary: "The 2026 theme and previous venue announcement.", href: "https://iwag.furries.id/en/updates/2025-09-20-electric-dreams" },
        { date: "17 July 2025", title: "Everything Goes On", summary: "A post-event retrospective for Return of the Wild.", href: "https://iwag.furries.id/en/updates/2025-07-17-everything-goes-on" },
        { date: "9 July 2025", title: "Get Ready to Pack!", summary: "A historical convention travel and packing checklist.", href: "https://iwag.furries.id/en/updates/2025-07-09-packing-up" },
        { date: "15 June 2025", title: "Ready, Set, Shop", summary: "A historical Dealers Den directory announcement for 2025.", href: "https://iwag.furries.id/en/updates/2025-06-15-dealers-den-reveal" },
        { date: "14 June 2025", title: "IWAG 2025 Hotel Reservation Update", summary: "A historical notice about an overbooking issue and attendee options.", href: "https://iwag.furries.id/en/updates/2025-06-14-hotel-reservation-update" },
        { date: "15 March 2025", title: "Meet the Guest of Honor", summary: "The Guest of Honor announcement for IWAG 2025.", href: "https://iwag.furries.id/en/updates/2025-03-15-goh-reveal" },
        { date: "12 February 2025", title: "IWAG 2025 Custom Merch", summary: "Custom artwork merchandise details for the 2025 sponsor tiers.", href: "https://iwag.furries.id/en/updates/2025-02-12-custom-merch" },
