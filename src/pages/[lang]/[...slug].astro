---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isLocale, localeKeys } from "../../i18n/locales";
import { nestedRoutes } from "../../i18n/nested-routes";

export function getStaticPaths() {
  return localeKeys.flatMap((lang) =>
    nestedRoutes.map((slug) => ({ params: { lang, slug }, props: { lang, slug } }))
  );
}

const langParam = Astro.params.lang;
const lang = isLocale(langParam) ? langParam : "en";
const slug = Astro.params.slug ?? "";
const segments = slug.split("/");
const lastSegment = segments.at(-1) ?? slug;
const title = lastSegment
  .replace(/^\d{4}-\d{2}-\d{2}-/, "")
  .split("-")
  .map((part) => part.length <= 3 ? part.toUpperCase() : part.charAt(0).toUpperCase() + part.slice(1))
  .join(" ");
const isUpdate = segments[0] === "updates";
const isVenueArticle = slug === "updates/2026-11-15-venue-reveal";
const isTeamArticle = slug === "updates/2026-11-08-staff-applications";
const archiveArticles: Record<string, { date: string; summary: string; details: string[] }> = {
  "updates/2026-01-24-volunteer": { date: "24 January 2026", summary: "A recruitment notice for volunteer support across event operations.", details: ["The source announcement listed security, runner, photography, videography, registration, medical, and audio-visual teams.", "It described volunteering as an event-day support role distinct from year-round staff planning.", "The source listed age and physical task expectations; these are historical 2026 criteria, not current recruitment terms."] },
  "updates/2026-01-28-dealers": { date: "28 January 2026", summary: "A historical call for vendors, community representatives, and creators wishing to display work at the 2026 Dealers Den.", details: ["The announcement described applications for merchandise sales, community representation, and display-only creative work.", "It outlined table dimensions, shared equipment, and limited electrical access as 2026 event arrangements.", "The announcement's application deadline and operational conditions have passed and must not be reused for a future event."] },
  "updates/2026-01-13-panel-registration": { date: "31 January 2026", summary: "An invitation for community members to propose panels and activities for IWAG 2026.", details: ["The source grouped proposals into entertainment, social, and educational categories.", "It described sessions typically lasting 30–60 minutes and organiser review based on relevance and community appeal.", "The application deadline and pass arrangements were specific to the 2026 event and are expired."] },
  "updates/2026-02-16-talent-show": { date: "16 February 2026", summary: "A historical invitation for solo and group performers to apply for the IWAG 2026 talent show.", details: ["The source requested a demonstration or record of the proposed act and supporting media.", "It described a maximum ten-minute performance and an all-ages content expectation.", "The submission deadline and application process have passed."] },
  "updates/2026-03-13-conbook": { date: "13 March 2026", summary: "A historical call for community artwork submissions to the IWAG 2026 convention book.", details: ["The source requested family-friendly artwork in JPG or PNG format and specified print-oriented dimensions and resolution.", "It described a review process for print suitability and publication in event media.", "The original submission deadline and artwork terms were specific to the 2026 publication."] },
  "updates/2026-03-14-art-show": { date: "14 March 2026", summary: "The 2026 event introduced a dedicated space for displaying and auctioning community-created artwork.", details: ["The source described display-only and auction submissions, with curation before exhibition.", "It outlined silent and live auction stages, creator pickup, and a service fee on successfully sold items.", "The original dimensions, bidding increments, fees, and event procedures are historical and are not V2 policy."] },
  "updates/2026-06-05-furcafe": { date: "5 June 2026", summary: "A themed café experience announced as part of the IWAG 2026 programme.", details: ["The source described a reserved dining experience with limited seating and menu selection.", "It stated that reservations were required and that a submitted form alone did not guarantee a seat.", "The schedule, hotel restaurant, prices, menu, and booking process applied to the 2026 venue and are expired."] },
  "updates/2026-07-14-conclusion": { date: "14 July 2026", summary: "A post-event retrospective covering new experiences, attendee feedback, and community media archives.", details: ["The source highlighted the 2026 Art Show and Fureats Café as new event experiences.", "It invited feedback and described attendee-submitted photo and video archives.", "The source requested consent for identifiable attendee images and asked contributors to avoid private spaces without permission."] },
  "updates/2024-08-31-theme-reveal": { date: "31 August 2024", summary: "The announcement revealed Return of the Wild as the theme for IWAG 2025 after a community vote.", details: ["The theme used a post-apocalyptic setting and framed renewal and nature's recovery as its central idea.", "This is a historical theme announcement for the 2025 edition."] },
  "updates/2024-11-01-venue-reveal": { date: "1 November 2024", summary: "The 2025 venue and event dates were announced as ibis Styles BSD and 12–13 July 2025.", details: ["The announcement described the Tangerang venue as the host location for the 2025 edition.", "Venue and date details are historical and must not be used for the 2027 Jakarta edition."] },
  "updates/2024-11-23-tier-reveal": { date: "23 November 2024", summary: "The first 2025 event-pass tier announcement described five tiers and a ladder-gift mechanism.", details: ["The source described Settler, Scout, Pathfindeer, Pioneer, and Guardian tiers.", "It announced ticketing and payment arrangements for the 2025 edition; these are not current pass terms."] },
  "updates/2024-12-29-registration-opening": { date: "29 December 2024", summary: "A pre-registration guide outlined the split opening schedule for 2025 event-pass tiers.", details: ["The source described separate release windows for lower tiers and sponsor tiers.", "It summarised account preparation, international payment options, transfers, upgrades, and age-related entry information.", "All times, payment methods, and policies are historical."] },
  "updates/2026-01-05-hotel-information": { date: "5 January 2026", summary: "A hotel reservation announcement for IWAG 2026 at ibis Styles Serpong BSD City.", details: ["The source listed historical room types, rates, stay dates, and a group-booking process.", "It described payment through the event team and a minimum age for hotel check-in.", "This venue and all hotel details are obsolete for IWAG 2027."] },
  "updates/2026-02-05-dj": { date: "5 February 2026", summary: "A historical call for DJs to submit mixes for the IWAG 2026 programme.", details: ["The source requested a 30–60 minute sample set and information about genre and prior performances.", "It described anonymous judging based on transitions, theme fit, pacing, and track selection.", "The application deadline and pass benefit applied only to the 2026 edition."] },
  "updates/2026-02-07-goh-reveal": { date: "7 February 2026", summary: "The announcement introduced digital artist and streamer Auveiss as Guest of Honor for IWAG 2026.", details: ["The source described Auveiss's digital-art, streaming, and multimedia work.", "Guest-of-honor and programme information is specific to the 2026 edition."] },
  "updates/2025-01-04-registration-update": { date: "4 January 2025", summary: "A registration update revised the 2025 pass release schedule after an inconvenient opening experience.", details: ["The announcement described additional lower-tier pass slots and staggered sponsor-tier registration windows.", "It also gave a historical hotel-booking opening date and starting rate.", "All schedules, prices, and availability are expired."] },
  "updates/2025-01-06-crash-postmortem": { date: "6 January 2025", summary: "A technical postmortem described service disruption during the first 2025 event-pass registration opening.", details: ["The source explained frontend, backend, single sign-on, database, and load-balancer components in accessible terms.", "It outlined database locking and scaling actions taken during the incident.", "This is a historical incident report, not a description of the current V2 system."] },
  "updates/2025-01-11-high-tier-raffle": { date: "12 January 2025", summary: "A raffle was announced for limited Pioneer and Guardian pass upgrades after some payments were invalidated.", details: ["The source described eligibility for existing lower-tier attendees and a random draw.", "It included a historical application deadline and payment window; both have passed."] },
  "updates/2025-01-12-iwag-2025-hotel-reservations": { date: "12 January 2025", summary: "Hotel reservations opened for the 2025 edition at ibis Styles BSD.", details: ["The article described room types, hotel facilities, breakfast, and group-booking procedures.", "The source included historical room rates and July 2025 stay dates.", "These details are unrelated to the 2027 Hotel Ciputra Jakarta venue."] },
  "updates/2025-02-12-custom-merch": { date: "12 February 2025", summary: "The announcement described custom artwork merchandise for Pioneer and Guardian passholders.", details: ["The source outlined bust-shot and full-body artwork benefits for the respective tiers.", "It described character-reference submission and a historical production deadline.", "Artist participation and artwork rights are not imported as V2 arrangements."] },
  "updates/2025-03-15-goh-reveal": { date: "15 March 2025", summary: "The 2025 Guest of Honor announcement introduced artist and streamer Kuttoyaki from Thailand.", details: ["The announcement described a talk-show panel about creative work, confidence, and convention experiences.", "Guest and programme information applies only to the 2025 edition."] },
  "updates/2025-06-14-hotel-reservation-update": { date: "14 June 2025", summary: "A hotel reservation update addressed an overbooking issue affecting some 2025 attendees.", details: ["The source described a full-refund option or relocation to a nearby hotel with shuttle service for affected reservations.", "This is an incident-specific historical notice and does not describe current hotel operations or V2 refund terms."] },
  "updates/2025-06-15-dealers-den-reveal": { date: "15 June 2025", summary: "The 2025 Dealers Den announcement presented a directory of participating vendor tables.", details: ["The source listed 22 vendor and event-support table positions.", "The directory is historical and is not a vendor list for IWAG 2027."] },
  "updates/2025-07-09-packing-up": { date: "9 July 2025", summary: "A pre-event packing guide offered practical reminders for convention travel.", details: ["The guide covered travel documents, clothing, hygiene items, payment methods, chargers, fursuit equipment, and luggage planning.", "It encouraged early preparation and checking airline baggage rules."] },
  "updates/2025-07-17-everything-goes-on": { date: "17 July 2025", summary: "A post-event thank-you and retrospective closed the Return of the Wild 2025 edition.", details: ["The source thanked attendees, volunteers, dealers, and panelists and invited feedback.", "It included guidance for uploading public event memories, including consent and private-space considerations.", "The source also invited the community to participate in choosing the 2026 theme."] },
  "updates/2025-09-20-electric-dreams": { date: "20 September 2025", summary: "The Electric Dreams theme and 4–5 July 2026 dates were announced for the next edition.", details: ["The announcement identified ibis Styles Serpong BSD City as the 2026 venue.", "The venue is obsolete for IWAG 2027 and is retained only as historical context."] },
  "updates/2025-11-15-event-pass-reveal": { date: "15 November 2025", summary: "The 2026 event-pass reveal introduced five tiers and described planned premium benefits.", details: ["The source outlined tiered benefits and a ladder-gift mechanism for the 2026 edition.", "It announced a January 2026 sales opening; prices, quotas, and registration details are historical."] },
  "updates/2025-12-19-updated-policies": { date: "19 December 2025", summary: "A policy-change announcement described revisions to the 2026 Code of Conduct, Terms and Conditions, and Privacy Policy.", details: ["The announcement listed subject areas including registration, attendee age verification, restricted items, recording, hotel conduct, commercial activity, liability, and creative work.", "It also described privacy-rights and media-coverage updates.", "The V1 documents are not adopted as V2 policy; this article is retained only as a historical record of the update announcement."] },
  "updates/2025-12-20-registration-information": { date: "20 December 2025", summary: "The announcement outlined the 2026 event-pass release schedule and a raffle-only top tier.", details: ["The source described Community ticketing, a separate raffle for the Architect tier, and early hotel booking for selected tiers.", "All registration windows, eligibility rules, and hotel booking dates are expired."] }
};
const isArchiveArticle = Boolean(archiveArticles[slug]);
const isUpdatePagination = isUpdate && ["2", "3", "4"].includes(lastSegment);
const isLegacyUpdate = isUpdate && !isVenueArticle && !isTeamArticle && !isArchiveArticle && !isUpdatePagination;
const isTransitGuide = slug === "location/public-transit-guide";
const isPrivateVehicleGuide = slug === "location/private-vehicles-guide";
const isTshirtGuide = slug === "participate/t-shirt-guide";
const isInternationalGuide = slug === "international-travelers-guide";
const isYchGuide = slug === "participate/super-sponsor-ych";
const isRoleIndex = slug === "join-iwag-team/roles";
const roleNames: Record<string, string> = {
  "attendee-experience-design-staff": "Attendee Experience Design Staff",
  "con-store-officer": "Con Store Officer",
  "dealer-relations-officer": "Dealer Relations Officer",
  "decoration-and-interior-team": "Decoration and Interior Team",
  "front-desk-staff": "Front Desk Staff",
  "fursuit-lounge-staff": "Fursuit Lounge Staff",
  "help-desk-staff": "Help Desk Staff",
  "logistics-staff": "Logistics Staff",
  "media-team": "Media Team"
};
const roleSlug = segments[1] === "roles" ? segments[2] : undefined;
const isRoleDetail = Boolean(roleSlug && roleNames[roleSlug]);
const roleTitle = roleSlug ? roleNames[roleSlug] : "Team roles";
const intro = lang === "id"
  ? "Rute ini dipertahankan dari inventaris arsip V1. Konten V2 sedang ditulis ulang dan belum diterbitkan pada pratinjau ini."
  : "This route is preserved from the V1 archive inventory. V2 content is being independently rewritten and is not published in this preview.";
const context = isUpdate
  ? (lang === "id" ? "Arsip rute pembaruan" : "Update route archive")
  : (lang === "id" ? "Arsip struktur peran tim" : "Team role route archive");
---
<BaseLayout lang={lang} title={title} description={intro}>
  <article class="page-content">
    <p class="eyebrow">IWAG V2 · {context}</p>
    <h1>{title}</h1>
    <p class="lead">{intro}</p>
    {isTransitGuide && <div class="article-body">
      <aside class="notice"><strong>{lang === "id" ? "Panduan perlu pembaruan" : "Guide requires a current update"}</strong><p>{lang === "id" ? "Panduan transportasi lama dibuat untuk venue BSD City. Lokasi yang diumumkan untuk IWAG 2027 adalah Hotel Ciputra Jakarta, sehingga rute lama tidak boleh diikuti sebagai petunjuk perjalanan." : "The older transport guide was written for the BSD City venue. IWAG 2027 is announced for Hotel Ciputra Jakarta, so the old route instructions must not be used as current travel directions."}</p></aside>
      <h2>{lang === "id" ? "Pilihan transportasi umum" : "Public transport options"}</h2>
      <p>{lang === "id" ? "Sistem transportasi umum kawasan Jakarta mencakup KRL Commuter Line, TransJakarta, MRT Jakarta, LRT Jakarta, dan LRT Jabodebek. Rute yang paling sesuai bergantung pada titik keberangkatan dan kondisi layanan saat perjalanan." : "Greater Jakarta public transport includes KRL Commuter Line, TransJakarta, MRT Jakarta, LRT Jakarta, and LRT Jabodebek. The most suitable route depends on your starting point and service conditions on the day."}</p>
      <h2>{lang === "id" ? "Rencanakan perjalanan" : "Plan your journey"}</h2>
      <ul><li>{lang === "id" ? "Periksa rute dan gangguan layanan melalui kanal resmi operator." : "Check routes and service disruptions through official operator channels."}</li><li>{lang === "id" ? "Pastikan halte atau stasiun yang dipilih benar-benar melayani tujuan di sekitar venue." : "Confirm that your selected stop or station serves the venue area."}</li><li>{lang === "id" ? "Sisakan waktu tambahan untuk perpindahan moda dan kondisi lalu lintas." : "Allow extra time for transfers and road traffic."}</li></ul>
      <p><a href="https://transportforjakarta.or.id/" rel="external">Transport for Jakarta</a></p>
      <p class="muted">{lang === "id" ? "Tarif, jadwal, rute, dan metode pembayaran dapat berubah. Periksa operator sebelum berangkat." : "Fares, schedules, routes, and payment methods can change. Check the operators before departure."}</p>
    </div>}
    {isPrivateVehicleGuide && <div class="article-body">
      <aside class="notice"><strong>{lang === "id" ? "Konten lama — jangan gunakan rute ini" : "Legacy content — do not use these directions"}</strong><p>{lang === "id" ? "Panduan kendaraan pribadi yang masih tersimpan di arsip mengarahkan pengunjung ke ibis Styles BSD City, venue lama. Lokasi IWAG 2027 yang diumumkan adalah Hotel Ciputra Jakarta. Informasi parkir, tarif, dan stasiun pengisian untuk venue baru belum dikonfirmasi dalam sumber yang diperiksa." : "The archived private-vehicle guide still directs visitors to ibis Styles BSD City, the previous venue. IWAG 2027 is announced for Hotel Ciputra Jakarta. Parking, rates, and charging information for the new venue were not confirmed in the sources reviewed."}</p></aside>
      <h2>{lang === "id" ? "Sebelum berkendara" : "Before driving"}</h2>
      <p>{lang === "id" ? "Gunakan alamat venue terbaru, periksa kondisi lalu lintas, kebijakan parkir hotel, serta pembatasan kendaraan yang berlaku pada hari perjalanan." : "Use the current venue address, check traffic conditions, the hotel's parking policy, and any vehicle restrictions in effect on your travel date."}</p>
      <p><a href={`/${lang}/location/`}>{lang === "id" ? "Kembali ke informasi venue" : "Return to venue information"}</a></p>
    </div>}
    {isInternationalGuide && <div class="article-body">
      <aside class="notice"><strong>{lang === "id" ? "Periksa aturan sebelum berangkat" : "Verify requirements before departure"}</strong><p>{lang === "id" ? "Panduan ini bukan nasihat imigrasi, hukum, atau perjalanan yang dipersonalisasi. Aturan bergantung pada kewarganegaraan, dokumen perjalanan, tujuan kunjungan, dan tanggal kedatangan. Gunakan situs pemerintah resmi untuk menentukan persyaratan yang berlaku." : "This guide is not personalised immigration, legal, or travel advice. Requirements depend on nationality, travel document, purpose of visit, and arrival date. Use official government websites to determine which requirements apply."}</p></aside>
      <h2>{lang === "id" ? "Sebelum memesan perjalanan" : "Before booking your trip"}</h2>
      <ul>
        <li>{lang === "id" ? "Pastikan paspor dan dokumen perjalanan memenuhi masa berlaku serta persyaratan negara tujuan." : "Confirm that your passport and travel document meet the destination's validity and entry requirements."}</li>
        <li>{lang === "id" ? "Periksa jenis visa atau fasilitas bebas visa berdasarkan kewarganegaraan dan tujuan perjalanan. Jangan menganggap semua pemegang paspor memenuhi syarat VOA." : "Check visa or visa-exemption eligibility by nationality and travel purpose. Do not assume every passport holder qualifies for VOA."}</li>
        <li>{lang === "id" ? "Siapkan tiket keluar/lanjutan, alamat akomodasi, dan dokumen pendukung yang diminta oleh otoritas." : "Prepare onward or return travel details, accommodation information, and supporting documents requested by the authorities."}</li>
        <li>{lang === "id" ? "Ajukan visa hanya melalui portal resmi Direktorat Jenderal Imigrasi." : "Apply for a visa only through the official Directorate General of Immigration portal."}</li>
      </ul>
      <p><a href="https://evisa.imigrasi.go.id/" rel="external">Official Indonesian e-Visa portal</a> · <a href="https://www.imigrasi.go.id/faq/visa" rel="external">Immigration visa FAQ</a></p>
      <h2>{lang === "id" ? "Deklarasi kedatangan All Indonesia" : "All Indonesia arrival declaration"}</h2>
      <p>{lang === "id" ? "Direktorat Jenderal Bea dan Cukai menjelaskan bahwa All Indonesia mengintegrasikan deklarasi imigrasi, bea cukai, kesehatan, dan karantina. Pengisian dapat dilakukan mulai H-3 hingga hari kedatangan. Gunakan portal resmi, simpan QR konfirmasi, dan waspadai situs tiruan yang meminta biaya untuk formulir pemerintah." : "Indonesia's Directorate General of Customs and Excise explains that All Indonesia integrates immigration, customs, health, and quarantine declarations. It can be completed from three days before arrival through arrival day. Use the official portal, keep the confirmation QR code, and beware of imitation sites charging for a government form."}</p>
      <p><a href="https://allindonesia.imigrasi.go.id/" rel="external">All Indonesia — official arrival portal</a> · <a href="https://www.beacukai.go.id/barang-penumpang" rel="external">Customs rules for passenger baggage</a> · <a href="https://www.beacukai.go.id/ecd" rel="external">Electronic Customs Declaration information</a></p>
      <h2>{lang === "id" ? "Tiba di Bandara Soekarno-Hatta (CGK)" : "Arriving at Soekarno-Hatta Airport (CGK)"}</h2>
      <p>{lang === "id" ? "Ikuti petunjuk resmi bandara untuk imigrasi, pengambilan bagasi, bea cukai, dan titik penjemputan. Jangan mengikuti orang yang menawarkan transportasi secara tidak resmi di area kedatangan." : "Follow airport signage for immigration, baggage reclaim, customs, and designated pickup areas. Do not follow unsolicited transport offers inside the arrivals area."}</p>
      <h3>{lang === "id" ? "Kereta bandara" : "Airport rail"}</h3>
      <p>{lang === "id" ? "Commuter Line Basoetta menghubungkan bandara dengan jaringan kereta di Jakarta. Akses stasiun melalui petunjuk terminal dan skytrain bandara. Periksa jadwal, stasiun pemberhentian, kapasitas bagasi, serta pembelian tiket pada operator sebelum memilih rute." : "Commuter Line Basoetta connects the airport with Jakarta's rail network. Follow terminal and airport skytrain signs to reach the station. Check the operator for current schedules, stops, luggage arrangements, and ticket purchase before choosing this option."}</p>
      <p><a href="https://airport-train.kci.id/" rel="external">KAI Commuter — official airport train ticket portal</a> · <a href="https://soekarnohatta.injourneyairports.id/access/city-transportation/airport-train" rel="external">Soekarno-Hatta Airport — airport train information</a></p>
      <h3>{lang === "id" ? "Taksi dan layanan perjalanan daring" : "Taxis and ride-hailing"}</h3>
      <ul><li>{lang === "id" ? "Gunakan loket atau pangkalan resmi, atau pesan melalui aplikasi yang kamu kenal." : "Use official taxi counters or ranks, or book through a recognised app."}</li><li>{lang === "id" ? "Cocokkan nama pengemudi, nomor kendaraan, dan titik jemput dengan aplikasi sebelum naik." : "Match the driver's name, vehicle registration, and pickup point with the app before entering the vehicle."}</li><li>{lang === "id" ? "Bagikan detail perjalanan kepada orang tepercaya dan simpan alamat hotel secara luring." : "Share trip details with someone you trust and keep your hotel address available offline."}</li></ul>
      <h2>{lang === "id" ? "Pembayaran dan uang tunai" : "Payments and cash"}</h2>
      <p>{lang === "id" ? "Ketersediaan kartu debit/kredit internasional, QRIS, uang elektronik, dan uang tunai berbeda antar-merchant dan moda transportasi. Tanyakan metode pembayaran sebelum transaksi, periksa biaya transaksi luar negeri pada bank penerbit kartu, dan siapkan metode cadangan." : "Acceptance of international debit or credit cards, QRIS, stored-value transit cards, and cash varies by merchant and transport mode. Ask about payment before a transaction, check foreign transaction fees with your card issuer, and keep a backup payment method."}</p>
      <p>{lang === "id" ? "Jangan mengandalkan satu aplikasi pembayaran atau menganggap QRIS dapat digunakan oleh setiap pengunjung asing. Dukungan lintas negara bergantung pada bank dan aplikasi asal." : "Do not rely on one payment app or assume every international visitor can use QRIS. Cross-border support depends on the visitor's home bank and payment app."}</p>
      <h2>{lang === "id" ? "Konektivitas seluler" : "Mobile connectivity"}</h2>
      <p>{lang === "id" ? "Periksa pilihan roaming operator asal atau paket SIM/eSIM turis dari penyedia resmi. Persyaratan registrasi perangkat, identitas, masa aktif, dan cakupan dapat berubah. Jangan membeli paket dari penjual tidak resmi." : "Check roaming options from your home carrier or tourist SIM/eSIM plans from an authorised provider. Device registration, identity, validity, and coverage requirements can change. Avoid purchasing plans from unofficial sellers."}</p>
      <h2>{lang === "id" ? "Perlengkapan dan kebutuhan khusus" : "Equipment and special needs"}</h2>
      <ul><li>{lang === "id" ? "Gunakan pelindung koper yang sesuai dan dokumentasikan kondisi bagasi sebelum check-in." : "Use suitable luggage protection and document your baggage condition before check-in."}</li><li>{lang === "id" ? "Jika membawa kostum, properti, atau peralatan besar, tanyakan kebijakan maskapai mengenai ukuran, baterai, bahan, dan bagasi khusus sebelum berangkat." : "If travelling with a costume, props, or bulky equipment, ask the airline about size, battery, material, and special-baggage rules before departure."}</li><li>{lang === "id" ? "Bawa adaptor daya yang sesuai dan periksa label tegangan/frekuensi perangkat; jangan menganggap semua perangkat kompatibel." : "Bring a suitable power adapter and check your device's voltage and frequency label; do not assume every device is compatible."}</li><li>{lang === "id" ? "Untuk kebutuhan aksesibilitas atau bantuan mobilitas, hubungi maskapai, bandara, dan hotel secara langsung sebelum perjalanan." : "For accessibility or mobility assistance, contact the airline, airport, and hotel directly before travelling."}</li></ul>
      <h2>{lang === "id" ? "Menuju venue IWAG 2027" : "Getting to the IWAG 2027 venue"}</h2>
      <p>{lang === "id" ? "Venue yang diumumkan adalah Hotel Ciputra Jakarta, Jl. Letnan Jenderal S Parman, Tanjung Duren, Grogol Petamburan, Jakarta Barat 11470. Rute terbaik dari bandara bergantung pada waktu tiba, bagasi, dan kondisi layanan. Periksa peta serta informasi hotel sebelum berangkat." : "The announced venue is Hotel Ciputra Jakarta, Jl. Letnan Jenderal S Parman, Tanjung Duren, Grogol Petamburan, West Jakarta 11470. The best airport route depends on arrival time, luggage, and service conditions. Check maps and hotel information before departure."}</p>
      <p><a href="https://hotelciputra.com/jakarta/" rel="external">Hotel Ciputra Jakarta — official website</a></p>
      <h2>{lang === "id" ? "Sumber resmi dan pembaruan" : "Official sources and updates"}</h2>
      <ul><li><a href="https://www.imigrasi.go.id/" rel="external">Directorate General of Immigration</a></li><li><a href="https://evisa.imigrasi.go.id/" rel="external">Official e-Visa</a></li><li><a href="https://allindonesia.imigrasi.go.id/" rel="external">All Indonesia arrival portal</a></li><li><a href="https://www.kai.id/" rel="external">KAI</a></li><li><a href="https://www.jakarta.go.id/" rel="external">Jakarta Provincial Government</a></li></ul>
      <p class="muted">{lang === "id" ? "Halaman ini ditulis ulang secara independen pada 23 November 2026. Informasi operasional bersifat dinamis dan tidak menggantikan instruksi otoritas, operator, maskapai, atau penyedia layanan." : "This page was independently written on 23 November 2026. Operational information is dynamic and does not replace instructions from authorities, operators, airlines, or service providers."}</p>
    </div>}
